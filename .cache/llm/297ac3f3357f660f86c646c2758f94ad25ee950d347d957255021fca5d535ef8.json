     {
      "text": "{\"story\":{\"as_a\":\"user\",\"i_want\":\"to mark a task as Completed\",\"so_that\":\"the task list shows which tasks are finished\",\"business_description\":\"The user can mark an existing task as Completed. The backend stores the status and sets the Completion Date. The task list then shows the new status, and the frontend reports success or failure only after the backend responds.\",\"business_value\":\"Users can see which tasks are finished without editing the whole task.\",\"acceptance_criteria\":[{\"given\":\"a task with status Open exists\",\"when\":\"the user marks the task as Completed\",\"then\":\"the backend stores the status Completed and the task list shows the task with status Completed\"},{\"given\":\"the status change request for an existing task succeeds in the backend\",\"when\":\"the frontend receives the success response\",\"then\":\"a success message is displayed and the task list shows the status Completed\"},{\"given\":\"the status change request for an existing task fails in the backend\",\"when\":\"the frontend receives the failure\",\"then\":\"the task list still shows the previous status and an error message is displayed\"},{\"given\":\"a status change request is pending and the backend has not responded yet\",\"when\":\"the task list is displayed\",\"then\":\"the row still shows the previous status and no success message is displayed\"},{\"given\":\"a status change request is sent for a task ID that does not exist\",\"when\":\"the backend processes the request\",\"then\":\"the backend returns a task not found error and no stored task changes\"},{\"given\":\"a status change request is sent with a status value other than Completed\",\"when\":\"the backend validates the request\",\"then\":\"the backend rejects the request with an invalid input error and the stored status does not change\"},{\"given\":\"a task is marked as Completed\",\"when\":\"the backend saves the change\",\"then\":\"the Completion Date field of the task is populated with the time of the change\"},{\"given\":\"a task is marked as Completed\",\"when\":\"the backend saves the change\",\"then\":\"the Last Updated Date field of the task is set to the time of the change\"}],\"edge_cases\":[\"A Completed task cannot be changed back to Open (reviewer decision).\",\"Open question: the acceptance criterion requiring Last Updated Date to be set on a status change conflicts with the reviewer decision that the status endpoint only sets Completion Date. This needs a reviewer decision before build.\",\"Open question: the response for a repeat Completed request on a task that is already Completed is not decided, so no acceptance criterion covers it.\"],\"dependencies\":[],\"definition_of_done\":[\"Status change endpoint marks an Open task as Completed and sets Completion Date\",\"Errors for missing task and invalid status are returned as specified\",\"Frontend shows success or error only after the backend response\",\"Test suite covers success, failure, pending and error paths\"]},\"fixes\":[{\"finding\":1,\"revised_tasks\":[],\"close_tasks\":[\"BE-status-change-last-updated-date\"]},{\"finding\":2,\"revised_tasks\":[]}]}",
