      "text": "{\"story\":{\"as_a\":\"team member tracking work\",\"i_want\":\"to mark a task as Completed\",\"so_that\":\"the task list shows which work is finished\",\"business_description\":\"Users can change the status of a task to Completed. The backend stores the new status and the time of completion. A Completed task cannot be changed back to another status.\",\"business_value\":\"Users can see which tasks are finished, and the status of a task is kept accurate.\",\"acceptance_criteria\":[{\"given\":\"a task with status Open exists\",\"when\":\"the user marks the task as Completed\",\"then\":\"the backend stores the status Completed and the task list shows the task with status Completed\"},{\"given\":\"the status change request for an existing task succeeds in the backend\",\"when\":\"the frontend receives the success response\",\"then\":\"a success message is displayed and the task list shows the status Completed\"},{\"given\":\"the status change request for an existing task fails in the backend\",\"when\":\"the frontend receives the failure\",\"then\":\"the task list still shows the previous status and an error message is displayed\"},{\"given\":\"a status change request is pending and the backend has not responded yet\",\"when\":\"the task list is displayed\",\"then\":\"the row still shows the previous status and no success message is displayed\"},{\"given\":\"a status change request is sent for a task ID that does not exist\",\"when\":\"the backend processes the request\",\"then\":\"the backend returns a task not found error and no stored task changes\"},{\"given\":\"a status change request is sent with a status value other than Completed\",\"when\":\"the backend validates the request\",\"then\":\"the backend rejects the request with an invalid input error and the stored status does not change\"},{\"given\":\"a task is marked as Completed\",\"when\":\"the backend saves the change\",\"then\":\"the Completion Date field of the task is populated with the time of the change\"},{\"given\":\"a task is marked as Completed\",\"when\":\"the backend saves the change\",\"then\":\"the Last Updated Date field of the task is set to the time of the change\"},{\"given\":\"a task has status Completed\",\"when\":\"a status change request is sent for that task\",\"then\":\"the stored status remains Completed\"}],\"edge_cases\":[\"The PRD does not say whether a status change request for a task that is already Completed succeeds or is rejected. This is an open question.\",\"There is no endpoint or control to change a Completed task back to Open or to any other status. This is a decision from the reviewer.\"],\"dependencies\":[],\"definition_of_done\":[\"The status change endpoint sets a task to Completed and populates Completion Date and Last Updated Date.\",\"The frontend shows a success message only after a confirmed backend success and never shows a success state before that.\",\"Error responses for missing tasks and invalid status values are returned as specified.\",\"A Completed task cannot be changed back to another status.\"]},\"fixes\":[{\"finding\":1,\"revised_tasks\":[{\"task_key\":\"FE-status-toggle-control\",\"task\":{\"key_slug\":\"status-toggle-control\",\"title\":\"[FE] Show success message after a confirmed Mark as Completed change\",\"track\":\"frontend\",\"area\":\"frontend\",\"description\":\"Add a Mark as Completed control for each task with pending, success and error states. Show a success message only after the backend confirms the status change. While the request is pending, show the previous status. On failure, keep the previous status and show an error message. Do not apply optimistic updates.\",\"size\":\"M\",\"consumes_api\":true,\"touches_db\":false,\"requirement_ids\":[\"R-2304218f\",\"R-ab9e9cb0\"],\"is_spike\":false,\"definition_of_done\":[\"A success message is shown only after a confirmed backend success.\",\"A failure keeps the previous status and shows an error message.\",\"No success state is shown while the request is pending.\"]}}],\"new_task\":{\"key_slug\":\"status-change-last-updated-date\",\"title\":\"[BE] Set Last Updated Date when a status change is saved\",\"track\":\"backend\",\"area\":\"backend\",\"description\":\"When the status change endpoint saves a change to a task, set the Last Updated Date field of that task to the time of the change.\",\"size\":\"S\",\"consumes_api\":false,\"touches_db\":true,\"requirement_ids\":[\"R-244669c0\"],\"is_spike\":false,\"definition_of_done\":[\"Saving a status change sets Last Updated Date to the time of the change.\",\"A failed status change does not change Last Updated Date.\"]},\"close_tasks\":[]},{\"finding\":2,\"revised_tasks\":[{\"task_key\":\"BE-status-change-endpoint\",\"task\":{\"key_slug\":\"status-change-endpoint\",\"title\":\"[BE] Add status change endpoint to set a task to Completed\",\"track\":\"backend\",\"area\":\"db\",\"description\":\"Add an endpoint that sets the status of a task to Completed and populates Completion Date. The endpoint supports only the Completed status. A task that is Completed cannot be changed back to another status.\",\"size\":\"S\",\"consumes_api\":false,\"touches_db\":true,\"requirement_ids\":[\"R-244669c0\",\"R-2304218f\"],\"is_spike\":false,\"definition_of_done\":[\"The endpoint sets the status to Completed and populates Completion Date.\",\"No endpoint path changes a Completed task back to another status.\",\"A Completed task keeps the status Completed after any status change request.\"]}}],\"new_task\":null,\"close_tasks\":[]}]}",
