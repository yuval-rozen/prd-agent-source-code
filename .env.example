# Copy to .env and fill in. Never commit .env.

# LLM provider: anthropic | google (default anthropic)
LLM_PROVIDER=anthropic

# Key of the chosen provider (required unless --replay)
ANTHROPIC_API_KEY=
# Google AI Studio key. Use a project WITHOUT billing so only the free tier is used.
# Free-tier prompts and responses may be used by Google to improve its products.
GOOGLE_API_KEY=

# Required only with --publish (fine-grained token, test repo only, Issues read/write, short expiry)
GITHUB_TOKEN=
GITHUB_REPO=

# Model per stage. Leave empty for the provider's defaults:
#   anthropic: EXTRACT=claude-haiku-5-5, GENERATION=claude-haiku-5-5, REVISION=claude-sonnet-5-5, CRITIC=claude-sonnet-5-5
#   (a cheap model generates, a stronger model reviews; see README "Model selection")
#   google:    EXTRACT=gemini-3.5-flash-lite, GENERATION=gemini-3.8-flash, CRITIC=gemini-3.8-flash (all free tier)
# During development all three can be set to claude-haiku-5-5 (with LLM_PROVIDER=anthropic).
# Models must belong to LLM_PROVIDER and have a price in config.py (only free-tier Gemini models are listed).
EXTRACT_MODEL=
GENERATION_MODEL=
# Update-run revisions and repairs (default claude-sonnet-5-5 / gemini-3.8-flash)
REVISION_MODEL=
CRITIC_MODEL=

# Hard cost cap per run, in USD (default 0.30). The run aborts when it is exceeded. Free-tier Gemini is $0.
MAX_RUN_COST_USD=0.30

# Gemini thinking level for generation and critic stages: minimal | low | medium | high (empty = model default)
GOOGLE_THINKING_LEVEL=

# Parallel LLM calls (empty = 4 for anthropic, 1 for google because of free-tier rate limits)
MAX_PARALLEL_CALLS=

# Reasoning effort per stage, Anthropic only: low | medium | high | xhigh | max (empty = low / medium / medium)
EXTRACT_EFFORT=
GENERATION_EFFORT=
REVISION_EFFORT=
CRITIC_EFFORT=

# Thresholds (empty = defaults from config.py)
MAX_REPAIR_ROUNDS=
GROUNDING_THRESHOLD=
DUPLICATE_TITLE_THRESHOLD=
REQ_DIFF_THRESHOLD=
