# Copy to .env and fill in. Never commit .env.

# Required unless --replay
ANTHROPIC_API_KEY=

# Required only with --publish (fine-grained token, test repo only, Issues read/write, short expiry)
GITHUB_TOKEN=
GITHUB_REPO=

# Models (empty = defaults from config.py)
GENERATION_MODEL=
CRITIC_MODEL=

# Thresholds (empty = defaults from config.py)
MAX_REPAIR_ROUNDS=
GROUNDING_THRESHOLD=
DUPLICATE_TITLE_THRESHOLD=
REQ_DIFF_THRESHOLD=
